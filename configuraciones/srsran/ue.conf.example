# Fragmento público: integrar en la plantilla ue.conf de srsRAN 4G release_25_10
# Todos los datos de autenticación siguientes son sintéticos.

[rf]
device_name = zmq
device_args = tx_port=tcp://*:2001,rx_port=tcp://localhost:2000,id=ue,base_srate=23.04e6

[rat.eutra]
dl_earfcn = 3350

[usim]
mode = soft
algo = milenage
opc = 00000000000000000000000000000000
k = 00000000000000000000000000000000
imsi = 001010000000001
imei = 353490000000001

[nas]
apn = internet
apn_protocol = ipv4

[gw]
netns = ue1
ip_devname = tun_srsue
ip_netmask = 255.255.255.0
